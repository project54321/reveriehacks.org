{
  "name": "reveriehacks-root",
  "private": true,
  "type": "module",
  "description": "Convenience wrapper: forwards commands to the app in ./ReverieHacks",
  "scripts": {
    "dev": "npm --prefix ReverieHacks run dev",
    "build": "npm --prefix ReverieHacks run build",
    "lint": "npm --prefix ReverieHacks run lint",
    "preview": "npm --prefix ReverieHacks run preview",
    "install:app": "npm --prefix ReverieHacks install"
  },
  "dependencies": {
    "vite": "^8.2.1"
  }
}
