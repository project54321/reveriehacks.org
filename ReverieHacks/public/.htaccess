# ReverieHacks — single-page app hosting config for Apache (GoDaddy shared hosting)

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files and folders directly (assets, fonts, images).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else falls back to index.html so client-side routes
  # (/about, /team, /sponsors, ...) work on a page refresh / direct link.
  RewriteRule ^ index.html [L]
</IfModule>

# Cache hashed build assets aggressively; keep index.html fresh.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2?|otf|ttf|png|jpg|jpeg|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
